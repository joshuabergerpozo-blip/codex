<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    <style>
      :root {
        --color-sun: {{ settings.color_sun }};
        --color-sun-deep: {{ settings.color_sun_deep }};
        --color-apricot: {{ settings.color_apricot }};
        --color-peach: {{ settings.color_peach }};
        --color-cream: {{ settings.color_cream }};
        --color-cocoa: {{ settings.color_cocoa }};
        --color-night: {{ settings.color_night }};
        --color-text: {{ settings.color_text }};
        --color-heading: {{ settings.color_heading }};
      }
      body { background: radial-gradient(120% 90% at 50% 0%, var(--color-apricot), var(--color-peach) 45%, var(--color-cream) 80%); }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
