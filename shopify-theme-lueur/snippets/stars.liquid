{%- comment -%} Étoiles de notation. Paramètres : rating (0-5), size {%- endcomment -%}
{%- assign rating = rating | default: 5 | plus: 0 -%}
<span class="stars" role="img" aria-label="{{ 'general.rating' | t: rating: rating }}">
  {%- for i in (1..5) -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" {% if i > rating %}opacity="0.3"{% endif %}><path fill="currentColor" d="M12 2.8l2.7 5.8 6.3.7-4.7 4.3 1.3 6.2L12 16.7l-5.6 3.1 1.3-6.2L3 9.3l6.3-.7z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
  {%- endfor -%}
</span>
