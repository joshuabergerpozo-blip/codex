<section class="section section--cream">
  <div class="page-width">
    <div class="form-card">
      <h1 class="h3" style="text-align:center">{{ 'customer.reset.title' | t }}</h1>
      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="field"><label for="ResetPassword">{{ 'customer.password' | t }}</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
        <div class="field"><label for="ResetConfirm">{{ 'customer.password_confirm' | t }}</label><input id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
        <button class="button button--full" type="submit">{{ 'customer.reset.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Nouveau mot de passe" }
{% endschema %}
