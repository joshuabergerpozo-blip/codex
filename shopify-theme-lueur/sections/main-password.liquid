<section class="section" style="min-height:100vh; display:grid; place-items:center; text-align:center">
  <div class="page-width" style="max-width:640px">
    <div style="width:120px; margin:0 auto 24px">{% render 'sun-mark', class: 'sun-404' %}</div>
    <h1 class="h2">{{ section.settings.title }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    <div class="newsletter">
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.label' | t }}</label>
        <input id="PasswordNewsletter" type="email" name="contact[email]" required placeholder="{{ 'newsletter.label' | t }}">
        <button class="button" type="submit">{{ 'password.notify' | t }}</button>
      {%- endform -%}
    </div>
    <details style="margin-top:40px">
      <summary style="cursor:pointer; font-weight:800">{{ 'password.owner' | t }}</summary>
      <div class="form-card" style="margin-top:16px">
        {%- form 'storefront_password' -%}
          {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
          <div class="field"><label for="Password">{{ 'password.password' | t }}</label><input id="Password" type="password" name="password" autocomplete="current-password"></div>
          <button class="button button--full" type="submit">{{ 'password.enter' | t }}</button>
        {%- endform -%}
      </div>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Page mot de passe",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Le soleil se lève bientôt." }
  ]
}
{% endschema %}
