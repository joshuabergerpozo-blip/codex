<article class="section section--cream">
  <div class="page-width" style="max-width: 820px">
    <p style="text-align:center"><span class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</span></p>
    <h1 class="h2" style="text-align:center">{{ article.title }}</h1>
    {%- if article.image -%}
      <div style="margin: 32px 0">{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', style: 'border-radius: var(--radius-lg)' }}</div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <p style="margin-top:40px"><a href="{{ blog.url }}">← {{ 'blogs.back' | t: title: blog.title }}</a></p>
  </div>
</article>

{% schema %}
{ "name": "Article" }
{% endschema %}
